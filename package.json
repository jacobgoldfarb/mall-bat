{
  "name": "drop-ceiling",
  "productName": "Mall Bats",
  "version": "1.0.0",
  "description": "A mall-squatter tycoon. Build a kingdom in the ceiling of a dying 2004 mall. Don't get caught.",
  "author": "Jacob Goldfarb",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --mac --win",
    "balance": "bun scripts/bot.ts",
    "art:generate": "bun scripts/art/generate.ts",
    "art:build": "bun scripts/art/build.ts"
  },
  "build": {
    "appId": "com.jacobgoldfarb.dropceiling",
    "productName": "Mall Bats",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "steam/steam_appid.txt",
        "to": "steam_appid.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0",
    "preact": "^11.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
